#!/bin/bash
#PBS -P CFP03-CF-051
#PBS -j oe
#PBS -N bias_inf_1pa
#PBS -J 0-24
#PBS -q auto
#PBS -l select=1:ncpus=50:mpiprocs=1:ompthreads=36:mem=250gb:ngpus=1
#PBS -l walltime=24:00:00

# Project allocation (CFP03-CF-051), auto queue.
# Runs all 25 EMRI 1PA points in parallel as a PBS array job.
# config_paris.py must have: TYPE="EMRI", run_type="1pa_vs_2pa", paris_seed_n=20

cd $PBS_O_WORKDIR

image="/app1/common/singularity-img/hopper/cuda/cuda_12.1.0-cudnn8-devel-u20.04.sif"

module load singularity

IDX=$PBS_ARRAY_INDEX
END=$((IDX + 1))

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference_1pa
mkdir -p "$LOG_DIR"
mkdir -p /scratch/josh.mat/opt_grid/results

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference_${IDX}.out.$PBS_JOBID" 2> "$LOG_DIR/inference_${IDX}.err.$PBS_JOBID"
source ~/.bashrc
conda activate few_env3
cd /scratch/josh.mat/bias_inference_emri/src
python -u inference.py --start $IDX --end $END --refine-only
EOF
