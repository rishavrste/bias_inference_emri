#!/bin/bash
# IMRI_TAIL 0PA MLE re-run: wider 7D search for pt14 to improve on log_L=181.82.
# The original run (intrinsic/5D, log_likelihood_phase_max, PSR=3) fixed Phi_r0
# in Stage 1 and only optimised it in the Stage 2 refine. This run uses
# intrinsic_phase (7D: m1,m2,a,p0,e0,Phi_phi0,Phi_r0) with log_likelihood so
# both phases are explicitly searched in Stage 1 too. PSR=5 for wider bounds.
# SKIP guard protects the existing 181.82.
# Submit for pt 14:
#   qsub -J 14-14 src/inference_imri_tail_0pa_mle_rerun.pbs

#PBS -P CFP03-CF-051
#PBS -j oe
#PBS -k oed
#PBS -N inference_imri_tail_0pa_mle_rerun
#PBS -q auto
#PBS -l select=1:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00

cd $PBS_O_WORKDIR

IDX=$PBS_ARRAY_INDEX
END=$((IDX + 1))

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference
mkdir -p "$LOG_DIR"

image="/app1/common/singularity-img/hopper/cuda/cuda_12.4.1-cudnn-devel-u22.04.sif"
module load singularity

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference_imri_tail_0pa_mle_rerun_${IDX}.out.$PBS_JOBID" 2> "$LOG_DIR/inference_imri_tail_0pa_mle_rerun_${IDX}.err.$PBS_JOBID"
PYTHON=/home/svu/josh.mat/miniconda3/bin/python3
export PYTHONUNBUFFERED=1
cd /home/svu/josh.mat/git_repos/bias_inference_emri/src
\$PYTHON inference.py --start $IDX --end $END \
    --run-type 0pa_vs_2pa \
    --type IMRI_TAIL \
    --optimizer differential_evolution \
    --parameter-selected intrinsic_phase \
    --prior-sigma-range 5 \
    --center-on-warmstart \
    --use-global-warmstart \
    --target-func log_likelihood \
    --result-suffix _mle \
    --de-maxiter 1000 \
    --de-popsize 15
EOF
