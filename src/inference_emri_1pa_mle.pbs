#!/bin/bash
# EMRI 1PA MLE run: maximise ln L = <h_true|h> - 0.5*<h|h>.
# Uses log_likelihood (phase in theta for 1PA).
# Warm-starts from overlap-optimal result array (overlap~1.0 for all pts).
#
# At SNR=20 the 1PA/2PA parameter bias is below 1 Fisher sigma and
# undetectable. This run uses a minimal DE (50 gens, popsize=5) just to
# seed the NM polish, which then converges to the SNR=20 MLE. PSR=0.1
# keeps the search in a tiny neighbourhood around the warm-start.
# Submit:
#   qsub -J 0-24 src/inference_emri_1pa_mle.pbs

#PBS -P CFP03-CF-051
#PBS -j oe
#PBS -k oed
#PBS -N inference_emri_1pa_mle
#PBS -q auto
#PBS -l select=1:ngpus=1:mem=128gb
#PBS -l walltime=02:00:00

cd $PBS_O_WORKDIR

IDX=$PBS_ARRAY_INDEX
END=$((IDX + 1))

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference
mkdir -p "$LOG_DIR"

image="/app1/common/singularity-img/hopper/cuda/cuda_12.4.1-cudnn-devel-u22.04.sif"
module load singularity

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference_emri_1pa_mle_${IDX}.out.$PBS_JOBID" 2> "$LOG_DIR/inference_emri_1pa_mle_${IDX}.err.$PBS_JOBID"
PYTHON=/home/svu/josh.mat/miniconda3/bin/python3
export PYTHONUNBUFFERED=1
cd /home/svu/josh.mat/git_repos/bias_inference_emri/src
\$PYTHON inference.py --start $IDX --end $END \
    --run-type 1pa_vs_2pa \
    --type EMRI \
    --optimizer differential_evolution \
    --parameter-selected intrinsic_phase \
    --prior-sigma-range 0.1 \
    --no-prior-floor \
    --center-on-warmstart \
    --use-global-warmstart \
    --target-func log_likelihood \
    --result-suffix _mle \
    --de-maxiter 50 \
    --de-popsize 5
EOF
