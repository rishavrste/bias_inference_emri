#!/bin/bash
# Single point:
#   qsub -v GRID_START=0 src/inference.pbs
#
# Full 0PA grid:
#   qsub -J 0-24 -v RUN_TYPE=0pa_vs_2pa src/inference.pbs
#
# Full 1PA grid:
#   qsub -J 0-24 -v RUN_TYPE=1pa_vs_2pa src/inference.pbs
#
# IMRI / IMRI_TAIL grids (default GRID_TYPE is EMRI):
#   qsub -J 0-24 -v RUN_TYPE=0pa_vs_2pa,GRID_TYPE=IMRI_TAIL src/inference.pbs
#
# Refine-only (skip PARIS):
#   qsub -v "GRID_START=0,REFINE_ONLY=1" src/inference.pbs
#
# The PBS_ARRAY_INDEX env var is set automatically for array jobs.
# GRID_START env var can override it for single-point submissions.

#PBS -P CFP03-CF-051
#PBS -j oe
#PBS -k oed
#PBS -N inference_emri
#PBS -q auto
#PBS -l select=1:ngpus=1:mem=128gb
#PBS -l walltime=10:00:00

cd $PBS_O_WORKDIR

# Resolve grid index: array job index takes priority, then GRID_START env var
if [ -n "$PBS_ARRAY_INDEX" ]; then
    IDX=$PBS_ARRAY_INDEX
elif [ -n "$GRID_START" ]; then
    IDX=$GRID_START
else
    IDX=0
fi
END=$((IDX + 1))

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference
mkdir -p "$LOG_DIR"

image="/app1/common/singularity-img/hopper/cuda/cuda_12.4.1-cudnn-devel-u22.04.sif"
module load singularity

EXTRA_ARGS=""
[ -n "$REFINE_ONLY"        ] && EXTRA_ARGS="$EXTRA_ARGS --refine-only"
[ -n "$RUN_TYPE"           ] && EXTRA_ARGS="$EXTRA_ARGS --run-type $RUN_TYPE"
[ -n "$GRID_TYPE"          ] && EXTRA_ARGS="$EXTRA_ARGS --type $GRID_TYPE"
[ -n "$PRIOR_SIGMA_RANGE"  ] && EXTRA_ARGS="$EXTRA_ARGS --prior-sigma-range $PRIOR_SIGMA_RANGE"
[ -n "$PARIS_SEED_N"       ] && EXTRA_ARGS="$EXTRA_ARGS --paris-seed-n $PARIS_SEED_N"

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference_${IDX}.out.$PBS_JOBID" 2> "$LOG_DIR/inference_${IDX}.err.$PBS_JOBID"
PYTHON=/home/svu/josh.mat/miniconda3/bin/python3
export PYTHONUNBUFFERED=1
cd /home/svu/josh.mat/git_repos/bias_inference_emri/src
\$PYTHON inference.py --start $IDX --end $END $EXTRA_ARGS
EOF
