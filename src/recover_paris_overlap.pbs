#!/bin/bash
#PBS -N recover_paris
#PBS -P CFP03-CF-051
#PBS -l select=1:ngpus=1:mem=32gb
#PBS -l walltime=00:30:00
#PBS -q auto
#PBS -j oe
#PBS -o /scratch/josh.mat/opt_grid/logs_inference/recover_paris.out

image="/app1/common/singularity-img/hopper/cuda/cuda_12.4.1-cudnn-devel-u22.04.sif"
module load singularity

SCRIPT="/home/svu/josh.mat/git_repos/bias_inference_emri/src/recover_paris_overlap.py"

RECOVER_POINTS="${RECOVER_POINTS:-18,21}"
GRID_TYPE="${GRID_TYPE:-IMRI_TAIL}"
RUN_TYPE="${RUN_TYPE:-1pa_vs_2pa}"

echo "Recovering pts: $RECOVER_POINTS  grid=$GRID_TYPE  run_type=$RUN_TYPE"
date

singularity exec --nv -e "$image" \
    env RECOVER_POINTS="$RECOVER_POINTS" GRID_TYPE="$GRID_TYPE" RUN_TYPE="$RUN_TYPE" \
    /home/svu/josh.mat/miniconda3/bin/python3 "$SCRIPT"

date
