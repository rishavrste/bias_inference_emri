#!/bin/bash
# Free-chi2 overlap maximisation for pt6 only.
# Starts from the fix-chi2=0.95 global warmstart (overlap=0.947) and lets chi2
# roam freely in [-1,1] so the DE can find the true overlap-optimal chi2.
# Chi2 is bounded in both DE (-1,1 enforced in differential_evolution_optimize)
# and NM (scipy bounds on index ndim-1, see inference.py lines 1414-1417).
# Run BEFORE inference_1pa_mle.pbs so the MLE warm-starts from the free-chi2 best.

#PBS -P CFP03-CF-051
#PBS -j oe
#PBS -k oed
#PBS -N inference_1pa_frechi2_pt6
#PBS -q auto
#PBS -l select=1:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00

cd $PBS_O_WORKDIR

IDX=6
END=7

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference
mkdir -p "$LOG_DIR"

image="/app1/common/singularity-img/hopper/cuda/cuda_12.4.1-cudnn-devel-u22.04.sif"
module load singularity

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference_1pa_frechi2_${IDX}.out.$PBS_JOBID" 2> "$LOG_DIR/inference_1pa_frechi2_${IDX}.err.$PBS_JOBID"
PYTHON=/home/svu/josh.mat/miniconda3/bin/python3
export PYTHONUNBUFFERED=1
cd /home/svu/josh.mat/git_repos/bias_inference_emri/src
\$PYTHON inference.py --start $IDX --end $END \
    --run-type 1pa_vs_2pa \
    --type IMRI_TAIL \
    --optimizer differential_evolution \
    --parameter-selected intrinsic_phase \
    --use-global-warmstart \
    --center-on-warmstart \
    --prior-sigma-range 5 \
    --target-func optimal_snr \
    --de-maxiter 300 \
    --de-popsize 10
EOF
