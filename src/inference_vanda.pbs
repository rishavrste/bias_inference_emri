#!/bin/bash
#PBS -j oe
#PBS -N bias_inference
#PBS -l select=1:ncpus=50:mpiprocs=1:ompthreads=36:mem=250gb:ngpus=1
#PBS -l walltime=24:00:00

# Personal allocation — no -P project flag, no -q queue flag.
# Set TYPE and RUN_TYPE in config_paris.py before submitting.
# Walltime guide (single grid point, GPU, PARIS):
#   IMRI_TAIL (T=0.25yr): ~1 hr
#   IMRI      (T=1yr):    ~4 hr
#   EMRI      (T=2.5yr):  ~8 hr

cd $PBS_O_WORKDIR

image="/app1/common/singularity-img/hopper/cuda/cuda_12.1.0-cudnn8-devel-u20.04.sif"

module load singularity

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference
mkdir -p "$LOG_DIR"
mkdir -p /scratch/josh.mat/opt_grid/results

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference.out.$PBS_JOBID" 2> "$LOG_DIR/inference.err.$PBS_JOBID"
source ~/.bashrc
conda activate few_env3
cd /scratch/josh.mat/bias_inference_emri/src
python -u inference.py
EOF
