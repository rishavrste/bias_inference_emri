#!/bin/bash
# MLE re-run for pt6 only, warm-starting from the global overlap-optimal result
# (overlap=0.9468, chi2=0.95 after free-chi2 run 529997). Chi2 is free in [-1,1]
# in both DE and NM (bounds enforced by inference.py). Matches the settings used
# for all other 24 pts in inference_1pa_mle.pbs.
#
# Submit after the free-chi2 overlap run completes:
#   qsub src/inference_1pa_mle_pt6.pbs

#PBS -P CFP03-CF-051
#PBS -j oe
#PBS -k oed
#PBS -N inference_1pa_mle_pt6
#PBS -q auto
#PBS -l select=1:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00

cd $PBS_O_WORKDIR

IDX=6
END=7

LOG_DIR=/scratch/josh.mat/opt_grid/logs_inference
mkdir -p "$LOG_DIR"

image="/app1/common/singularity-img/hopper/cuda/cuda_12.4.1-cudnn-devel-u22.04.sif"
module load singularity

singularity exec --nv -e "$image" bash << EOF > "$LOG_DIR/inference_1pa_mle_${IDX}.out.$PBS_JOBID" 2> "$LOG_DIR/inference_1pa_mle_${IDX}.err.$PBS_JOBID"
PYTHON=/home/svu/josh.mat/miniconda3/bin/python3
export PYTHONUNBUFFERED=1
cd /home/svu/josh.mat/git_repos/bias_inference_emri/src
\$PYTHON inference.py --start $IDX --end $END \
    --run-type 1pa_vs_2pa \
    --type IMRI_TAIL \
    --optimizer differential_evolution \
    --parameter-selected intrinsic_phase \
    --use-global-warmstart \
    --center-on-warmstart \
    --prior-sigma-range 3 \
    --target-func log_likelihood \
    --result-suffix _mle \
    --de-maxiter 300 \
    --de-popsize 10
EOF
